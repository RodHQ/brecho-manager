DJANGO_SECRET_KEY=replace-this-in-development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MongoDB (usado pelo docker-compose.yml e pelo settings.py via MongoEngine)
# MONGO_USERNAME e MONGO_PASSWORD alimentam o MONGO_INITDB_ROOT_USERNAME/PASSWORD
# do container do MongoDB.
MONGO_USERNAME=admin
MONGO_PASSWORD=senha_segura
MONGO_DB=brecho_manager
# Use "mongodb" quando a aplicação Django também rodar em um contêiner na mesma
# rede do docker-compose. Se você rodar o Django diretamente na sua máquina
# (fora do Docker), use "localhost".
MONGO_HOST=mongodb
MONGO_PORT=27017
